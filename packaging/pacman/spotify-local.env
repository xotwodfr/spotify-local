# /etc/spotify-local/spotify-local.env
# System-wide defaults for the Spotify Local launcher (sourced by /usr/bin/spotify-local).
#
# Pre-configured Navidrome server URL shown on the login screen. Leave empty
# (or comment out) to let users type their own server on first launch.
# NAVIDROME_URL=""
# NEXT_PUBLIC_NAVIDROME_URL=""
